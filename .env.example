# Set Architect — environment variables (names only; real values live in .env, gitignored)
# App runs fully in DEMO MODE with this file empty.

# --- SaaS mode (Supabase auth + db) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Music data (each optional; adapter disables itself when empty) ---
GETSONGBPM_API_KEY=        # free — getsongbpm.com/api (requires visible backlink, rendered automatically)
SOUNDSTAT_API_KEY=         # paid-lite — soundstat.info ($0.01/track) for energy/danceability
SPOTIFY_CLIENT_ID=         # free — developer.spotify.com (id lookup + link-out only; enables ReccoBeats energy)
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=            # free non-commercial — last.fm/api (similar tracks)
YOUTUBE_API_KEY=           # optional — reuse existing key from market-research project
